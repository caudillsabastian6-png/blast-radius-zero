# Copy to ".env" and fill in at deploy time. NEVER commit a real .env.
# The API key exists only in the agent process's environment at runtime.
# It is never hard-coded, and it is never passed into the sandbox worker.

# Inference: "vultr" (real) or "mock" (offline dry-run with a scripted stub)
BRZ_INFERENCE=vultr

# Vultr Serverless Inference key (Console: Products -> Serverless -> Inference)
VULTR_INFERENCE_API_KEY=

# Optional override; default is the documented API base.
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Model ID - list choices with GET {base}/models and pick one, e.g. a
# llama-3.3-70b-instruct or qwen2.5-32b-instruct class model from the console.
BRZ_MODEL=

# Sandbox: "docker" (production boundary) or "local" (development only)
BRZ_SANDBOX=docker
BRZ_WORKER_IMAGE=brz-worker:latest

# Loop limits
BRZ_MAX_STEPS=12
BRZ_TOOL_TIMEOUT=20

# HTTP
BRZ_PORT=8080
